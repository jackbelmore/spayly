    "textures": "node godot/tools/prepare-textures.mjs",
    "ephemeris": "node scripts/fetch-ephemeris.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
