<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Godot.NET.Sdk and GodotSharp 4.8.0-dev.6 are on nuget.org (checked 2026-09-25), so no machine-specific path to
       the editor's bundled nupkgs: a clone restores on any computer. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
