; Engine configuration file.
; Hand-written; keep it minimal. CaptureDriver is an autoload so any scene can be measured.

config_version=5

[application]

config/name="ScaleSpike"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.8", "C#", "Forward Plus")

[autoload]

CaptureDriver="*res://CaptureDriver.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
; Uncapped so dt_ms measures throughput rather than the monitor's refresh.
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="ScaleSpike"

[rendering]

renderer/rendering_method="forward_plus"
